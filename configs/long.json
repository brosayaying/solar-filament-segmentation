{
  "data": {
    "root": "MAGFiLO_1.0_Kaggle_2026",
    "ann_file": "train/MAGFiLO_1.0_Annotations_kaggle2026_train.json",
    "split_file": "splits/date_seed42.json",
    "group_by": "date",
    "val_frac": 0.2,
    "seed": 42,
    "patch_size": 512,
    "samples_per_image": 2,
    "mean": 0.5,
    "std": 0.25,
    "num_workers": 8
  },
  "model": {
    "backbone": "resnet34",
    "pretrained": true,
    "in_chans": 1,
    "decoder_dim": 128,
    "out_ch": 1,
    "dropout": 0.0
  },
  "train": {
    "loss": "bce_dice",
    "epochs": 160,
    "batch_size": 12,
    "lr": 0.0003,
    "weight_decay": 0.0001,
    "warmup_epochs": 2,
    "amp": true,
    "grad_clip": 1.0,
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "val_every": 1,
    "val_images": 64,
    "out_dir": "runs",
    "run_name": "long_160ep_512"
  },
  "eval": {
    "threshold": 0.55,
    "min_area": 512,
    "batch_size": 1
  }
}
