{
  "data": {
    "root": "MAGFiLO_1.0_Kaggle_2026",
    "ann_file": "train/MAGFiLO_1.0_Annotations_kaggle2026_train.json",
    "split_file": "v2/splits/week5_seed42/fold4.json",
    "group_by": "week",
    "seed": 42,
    "patch_size": 512,
    "samples_per_image": 2,
    "mean": 0.4254,
